# ---- Router ----
ROUTER_PORT="21450"
ROUTER_KEY="change-me-to-a-long-random-string"   # Claude Code will use this as ANTHROPIC_AUTH_TOKEN
# The UI lives at http://127.0.0.1:21450/ui. The first visit asks you to create the admin account;
# after that you sign in with a username and password. ROUTER_KEY is only for Claude Code and scripts.
# Headless install? Uncomment both to create the first admin at startup, then delete the password line.
# ADMIN_USER=admin
# ADMIN_PASSWORD=change-me-please
# Keys can also be added from the UI; they are written here and never to routes.json.

# ---- Provider key pools (add as many as you want; list them in routes.json) ----
DEEPSEEK_KEY_1=""
DEEPSEEK_KEY_2=""
ZAI_KEY_1=""
ZAI_KEY_2=""
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
OPENROUTER_KEY_3=
OPENCODE_KEY_1=""
OPENCODE_KEY_2=""
OPENCODE_KEY_3=""
OPENCODE_KEY_4=""
# ANTHROPIC_KEY_1=
