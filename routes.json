{
  "_note": "Edit freely - the router hot-reloads this file. VERIFY every 'model' string against the provider's current model list.",
  "defaultModel": "glm",
  "aliases": {
    "opus": "ds-pro",
    "sonnet": "glm",
    "haiku": "ds-flash"
  },
  "providers": {
    "deepseek": {
      "baseURL": "https://api.deepseek.com/anthropic",
      "auth": "both",
      "keys": [
        "DEEPSEEK_KEY_1",
        "DEEPSEEK_KEY_2"
      ]
    },
    "zai": {
      "baseURL": "https://api.z.ai/api/anthropic",
      "auth": "both",
      "keys": [
        "ZAI_KEY_1",
        "ZAI_KEY_2"
      ]
    },
    "openrouter": {
      "baseURL": "https://openrouter.ai/api",
      "auth": "bearer",
      "keys": [
        "OPENROUTER_KEY_1",
        "OPENROUTER_KEY_2",
        "OPENROUTER_KEY_3"
      ]
    },
    "opencode": {
      "baseURL": "https://opencode.ai/zen",
      "auth": "both",
      "keys": [
        "OPENCODE_ZEN_KEY_1"
      ]
    }
  },
  "models": {
    "ds-pro": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "key": "DEEPSEEK_KEY_1",
      "fallback": [
        "glm",
        "glm-fast",
        "or-b",
        "oc-haiku",
        "oc-free",
        "ds-flash"
      ]
    },
    "ds-flash": {
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "key": "DEEPSEEK_KEY_1"
    },
    "glm": {
      "provider": "zai",
      "model": "glm-5.3",
      "key": "ZAI_KEY_1",
      "fallback": [
        "ds-flash"
      ]
    },
    "glm-fast": {
      "provider": "zai",
      "model": "glm-5.3-flash",
      "key": "ZAI_KEY_1",
      "fallback": [
        "glm"
      ]
    },
    "or-b": {
      "provider": "openrouter",
      "model": "openrouter/free",
      "key": "OPENROUTER_KEY_1",
      "fallback": [
        "glm-fast",
        "ds-flash"
      ]
    },
    "oc-haiku": {
      "provider": "opencode",
      "model": "big-pickle",
      "key": "OPENCODE_ZEN_KEY_1"
    },
    "oc-free": {
      "provider": "opencode",
      "model": "space-bunny-free",
      "key": "OPENCODE_ZEN_KEY_1"
    }
  }
}
