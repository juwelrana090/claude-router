{
  "_note": "Edit freely - the router hot-reloads this file. VERIFY every 'model' string against the provider's current model list.",
  "defaultModel": "groq-120b",
  "aliases": {
    "opus": "or-free",
    "sonnet": "groq-120b",
    "haiku": "groq-fast"
  },
  "providers": {
    "openrouter-free": {
      "baseURL": "https://openrouter.ai/api",
      "auth": "bearer",
      "keys": [
        "OPENROUTER_API_KEY"
      ],
      "dailyRequests": 50
    },
    "groq-free": {
      "baseURL": "https://api.groq.com/openai/v1",
      "auth": "bearer",
      "keys": [
        "GROQ_API_KEY"
      ],
      "protocol": "openai",
      "dailyRequests": 1000
    },
    "ollama-cloud": {
      "baseURL": "https://ollama.com",
      "auth": "both",
      "keys": [
        "OLLAMA_CLOUD_API_KEY"
      ],
      "dropBeta": false,
      "dropBodyFields": [
        "ollama"
      ],
      "disabled": false
    },
    "deepseek-web": {
      "baseURL": "https://chat.deepseek.com",
      "auth": "bearer",
      "keys": [
        "DS_WEB_USER_TOKEN"
      ],
      "protocol": "deepseek-web",
      "dailyRequests": 200
    }
  },
  "models": {
    "or-free": {
      "provider": "openrouter-free",
      "model": "openrouter/free",
      "key": "OPENROUTER_API_KEY",
      "fallback": [
        "ol-flash"
      ]
    },
    "groq-120b": {
      "provider": "groq-free",
      "model": "openai/gpt-oss-120b",
      "key": "GROQ_API_KEY",
      "fallback": [
        "or-free",
        "ol-flash"
      ]
    },
    "groq-fast": {
      "provider": "groq-free",
      "model": "llama-3.1-8b-instant",
      "key": "GROQ_API_KEY",
      "fallback": [
        "ol-flash"
      ]
    },
    "ol-flash": {
      "provider": "ollama-cloud",
      "model": "deepseek-v4.1-flash",
      "key": "OLLAMA_CLOUD_API_KEY"
    },
    "ds-web": {
      "provider": "deepseek-web",
      "model": "deepseek-v4-flash",
      "key": "DS_WEB_USER_TOKEN"
    },
    "ds-web-think": {
      "provider": "deepseek-web",
      "model": "deepseek-v4-flash-think",
      "key": "DS_WEB_USER_TOKEN"
    },
    "ds-web-search": {
      "provider": "deepseek-web",
      "model": "deepseek-v4-flash-search",
      "key": "DS_WEB_USER_TOKEN"
    }
  }
}
