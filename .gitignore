/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.claude/worktrees

# Ignore local environment files
.env
.env.local
.env.*.local
.env.production
.env.*


# Ignore log files
*.log
logs
*.log.*
logs/*

# Ignore all type of compressed files
*.zip
*.tar.gz
*.tar
*.rar
*.7z
*.gz
*.bz2
*.xz
*.tgz
*.tar.xz
*.tar.bz2

